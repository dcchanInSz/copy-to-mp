    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "marked": "^12.0.0",
    "dompurify": "^3.0.9"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "~5.3.3",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
